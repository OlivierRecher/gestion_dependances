# Toutes ces variables sont optionnelles : l'API demarre sans aucune d'elles.
# Chacune est validee au demarrage ; une valeur invalide arrete le processus
# avec un message explicite, plutot que de casser a la premiere requete.

PORT=3000

# --- Geocodage (Nominatim) ---
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=api-meteo/1.0 (TP gestion des dependances)
GEOCODING_TIMEOUT_MS=3000

# --- Previsions (Open-Meteo) ---
FORECAST_BASE_URL=https://api.open-meteo.com
FORECAST_TIMEOUT_MS=3000

# --- Cache (disponibilite, pas performance) ---
# TTL : duree pendant laquelle la donnee est servie sans rappeler le service.
# STALE : duree pendant laquelle elle reste servie *si le service est tombe*.
CACHE_TTL_MS=300000
CACHE_STALE_TTL_MS=3600000
CACHE_MAX_ENTRIES=500

# --- Circuit breaker (par service externe) ---
BREAKER_FAILURE_THRESHOLD=3
BREAKER_RESET_TIMEOUT_MS=15000
